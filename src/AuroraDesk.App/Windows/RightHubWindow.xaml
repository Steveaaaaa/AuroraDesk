<Window x:Class="AuroraDesk.App.Windows.RightHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="248" Height="686" Title="收纳工作台"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border x:Name="RootBorder" CornerRadius="18" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="AccentBar" Width="3.5" Height="16" CornerRadius="1.5" Background="#A78BFA" Margin="0,0,8,0"/>
                    <TextBlock Text="收纳工作台" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" FontFamily="Microsoft YaHei UI"/>
                </StackPanel>
                <TextBlock x:Name="DateText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B8C4D8" FontSize="11" FontFamily="Microsoft YaHei UI"/>
                <Border VerticalAlignment="Bottom" Height="1" Background="#1FFFFFFF"/>
            </Grid>

            <!-- Scrollable Single-Column Category Cards (supports 4..12+ categories!) -->
            <ScrollViewer Grid.Row="1" Margin="0,8,0,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CategoriesPanel"/>
            </ScrollViewer>

            <!-- Footer Status & Action Bar -->
            <Grid Grid.Row="2">
                <Border VerticalAlignment="Top" Height="1" Background="#1FFFFFFF"/>
                <TextBlock x:Name="SysStatusText" Text="CPU --%  ·  内存 --%  ·  余 --G"
                           HorizontalAlignment="Center" Margin="0,9,0,0"
                           Foreground="#CBD5E1" FontSize="10.5" FontFamily="Microsoft YaHei UI"/>
                <UniformGrid Columns="3" VerticalAlignment="Bottom" Height="34">
                    <Border Style="{StaticResource GlassCardBtn}" Margin="0,0,4,0" MouseLeftButtonUp="BtnTidy_Click" ToolTip="一键智能归档桌面新文件">
                        <TextBlock Text="整理" Foreground="#E2D9FF" FontSize="11.5" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GlassCardBtn}" Margin="2,0,2,0" MouseLeftButtonUp="BtnSearch_Click" ToolTip="全局秒搜 (Alt + Space)">
                        <TextBlock Text="秒搜" Foreground="#E2D9FF" FontSize="11.5" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GlassCardBtn}" Margin="4,0,0,0" MouseLeftButtonUp="BtnSettings_Click" ToolTip="打开设置与分类定制中心">
                        <TextBlock Text="设置" Foreground="#E2D9FF" FontSize="11.5" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
