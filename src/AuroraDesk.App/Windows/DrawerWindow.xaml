<Window x:Class="AuroraDesk.App.Windows.DrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="350" Height="686" Title="候选清单" AllowDrop="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border x:Name="RootBorder" CornerRadius="18" BorderBrush="#48A78BFA" BorderThickness="1" Padding="14,12">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="180">
                    <Border x:Name="AccentBar" Width="3.5" Height="16" CornerRadius="1.5" Background="#38BDF8" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText" Text="分类列表" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold"
                               FontFamily="Microsoft YaHei UI" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="BtnUp" Style="{StaticResource GlassCardBtn}" Width="28" Height="28" Margin="0,0,5,0"
                            MouseLeftButtonUp="BtnUp_Click" ToolTip="返回上一级目录">
                        <TextBlock Text="↑" Foreground="#CBD5E1" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Style="{StaticResource GlassCardBtn}" Height="28" Padding="9,0" Margin="0,0,5,0"
                            MouseLeftButtonUp="BtnOpenDir_Click" ToolTip="在资源管理器中打开此文件夹">
                        <TextBlock Text="打开目录" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#38F43F5E" BorderBrush="#66F472B6" BorderThickness="1" CornerRadius="8" Width="28" Height="28"
                            Cursor="Hand" MouseLeftButtonUp="BtnClose_Click" ToolTip="收起">
                        <TextBlock Text="✕" Foreground="#FDA4AF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Instant Filter Box -->
            <Border Grid.Row="1" Background="#28141622" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="9" Margin="0,4,0,4" Padding="8,0">
                <Grid>
                    <TextBlock x:Name="FilterPlaceholder" Text="输入名称或拼音首字母筛选..." Foreground="#66CBD5E1" FontSize="11"
                               FontFamily="Microsoft YaHei UI" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="FilterBox" Background="Transparent" BorderThickness="0" Foreground="#F1F5F9" CaretBrush="#A78BFA"
                             FontSize="11.5" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center" TextChanged="FilterBox_TextChanged"/>
                </Grid>
            </Border>

            <!-- Smooth Scroll List -->
            <ScrollViewer x:Name="ItemsScrollViewer" Grid.Row="2" Margin="0,4,0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ItemsPanel"/>
            </ScrollViewer>

            <!-- Bottom Hint -->
            <TextBlock x:Name="FooterHint" Grid.Row="3" Text="单击启动 · 拖到右侧卡片换分类 · 右键管理"
                       Foreground="#88CBD5E1" FontSize="10" FontFamily="Microsoft YaHei UI"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
