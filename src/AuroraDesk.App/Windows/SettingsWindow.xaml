<Window x:Class="AuroraDesk.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="560" WindowStartupLocation="CenterScreen"
        Background="#131520" Foreground="#F1F5F9" Title="AuroraDesk 设置与定制中心">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="20" CornerRadius="2" Background="#A78BFA" Margin="0,0,10,0"/>
                <TextBlock Text="AuroraDesk 定制与管理中心" FontSize="17" FontWeight="Bold" FontFamily="Microsoft YaHei UI"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                       Text="By Steveaaaaa and Xiaoleng" FontSize="11" Foreground="#8790A9" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="#1A1D2D" BorderBrush="#2E334D" Foreground="#F1F5F9" Margin="0,8,0,10">
            <!-- Tab 1: Categories & Templates -->
            <TabItem Header="📁 分类管理与模板" Padding="14,6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="快速应用模板：" VerticalAlignment="Center" Foreground="#CBD5E1" Margin="0,0,8,0"/>
                        <Button Content="通用学生 / 工科办公版" Padding="10,5" Margin="0,0,8,0" Click="BtnTpl1_Click"/>
                        <Button Content="程序员 / 工科开发版" Padding="10,5" Margin="0,0,8,0" Click="BtnTpl2_Click"/>
                        <Button Content="+ 新增分类" Padding="10,5" Click="BtnAddCat_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="CategoriesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="#131520" Foreground="#F1F5F9" RowBackground="#1A1D2E" AlternatingRowBackground="#1E2236"
                              BorderBrush="#2E334D" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#28FFFFFF"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#24283D"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件夹名" Binding="{Binding FolderName}" Width="140"/>
                            <DataGridTextColumn Header="显示标题" Binding="{Binding Title}" Width="125"/>
                            <DataGridTextColumn Header="副标题说明" Binding="{Binding Subtitle}" Width="165"/>
                            <DataGridTextColumn Header="色条色值" Binding="{Binding AccentHex}" Width="80"/>
                            <DataGridTextColumn Header="自定义关键词" Binding="{Binding Keywords}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="删除选中分类" Padding="10,5" Click="BtnDelCat_Click"/>
                        <TextBlock Text="  提示：修改后点击右下角「保存并立即生效」即可实时刷新工作台" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Appearance -->
            <TabItem Header="🎨 毛玻璃外观" Padding="14,6">
                <StackPanel Margin="18">
                    <TextBlock Text="浮窗底色浓度（越低越通透、越突出壁纸）：" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Slider x:Name="OpacitySlider" Minimum="0.18" Maximum="0.82" TickFrequency="0.05" Width="360"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                        <TextBlock x:Name="OpacityValueText" Text="45%" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#A78BFA" FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Text="主题强调光效色：" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Button Content="樱花紫 (#A78BFA)" Tag="#A78BFA" Padding="10,6" Margin="0,0,8,0" Click="AccentPreset_Click"/>
                        <Button Content="极光蓝 (#38BDF8)" Tag="#38BDF8" Padding="10,6" Margin="0,0,8,0" Click="AccentPreset_Click"/>
                        <Button Content="翡翠绿 (#34D399)" Tag="#34D399" Padding="10,6" Margin="0,0,8,0" Click="AccentPreset_Click"/>
                        <Button Content="琥珀金 (#FBBF24)" Tag="#FBBF24" Padding="10,6" Margin="0,0,8,0" Click="AccentPreset_Click"/>
                        <Button Content="珊瑚粉 (#F472B6)" Tag="#F472B6" Padding="10,6" Click="AccentPreset_Click"/>
                    </StackPanel>

                    <Button Content="重置所有浮窗到默认左右停靠位置" HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,18" Click="BtnResetPos_Click"/>

                    <Border Background="#182032" BorderBrush="#2E3654" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="任务栏透明化（类 TranslucentTB · Win11 XAML 挂载 + Win10 兼容）" FontSize="13" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkTaskbarEnable" Content="启用任务栏透明（退出 AuroraDesk 时自动无损还原原生任务栏）" Foreground="#F1F5F9" FontSize="12.5" Margin="0,0,0,10" Click="TaskbarOption_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="桌面态样式：" VerticalAlignment="Center" Foreground="#CBD5E1" Margin="0,0,10,0"/>
                                <RadioButton x:Name="RbTaskbarClear" GroupName="TaskbarStyle" Content="全透明 (Clear)" Foreground="#F1F5F9" Margin="0,0,16,0" Click="TaskbarOption_Changed"/>
                                <RadioButton x:Name="RbTaskbarTranslucent" GroupName="TaskbarStyle" Content="深色半透明" Foreground="#F1F5F9" Margin="0,0,16,0" Click="TaskbarOption_Changed"/>
                                <RadioButton x:Name="RbTaskbarAcrylic" GroupName="TaskbarStyle" Content="毛玻璃 (Acrylic)" Foreground="#F1F5F9" Click="TaskbarOption_Changed"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkTaskbarDarkMax" Content="窗口最大化时开启自适应毛玻璃（随当前窗口底部主色调平滑渐变）" Foreground="#CBD5E1" FontSize="12" Click="TaskbarOption_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="收纳盒透明度" Padding="14,6">
                <StackPanel Margin="18" MaxWidth="475" HorizontalAlignment="Left">
                    <CheckBox x:Name="ChkAdaptiveStorage" Content="智能透明" Foreground="#F1F5F9" FontSize="13"
                              FontWeight="SemiBold" Click="AdaptiveStorage_Click"/>
                    <Grid x:Name="StorageRangePanel" Margin="0,18,0,0" IsEnabled="{Binding IsChecked, ElementName=ChkAdaptiveStorage}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="54"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <Label Target="{Binding ElementName=StorageMinSlider}" Content="最通透" Foreground="#CBD5E1"
                               Padding="0" VerticalAlignment="Center"/>
                        <Slider x:Name="StorageMinSlider" Grid.Column="1" Width="270" VerticalAlignment="Center"
                                TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="StorageRange_Changed"/>
                        <TextBlock x:Name="StorageMinText" Grid.Column="2" Foreground="#C4B5FD"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                        <Label Grid.Row="1" Target="{Binding ElementName=StorageMaxSlider}" Content="最不透明" Foreground="#CBD5E1"
                               Padding="0" VerticalAlignment="Center"/>
                        <Slider x:Name="StorageMaxSlider" Grid.Row="1" Grid.Column="1" Width="270" VerticalAlignment="Center"
                                TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="StorageRange_Changed"/>
                        <TextBlock x:Name="StorageMaxText" Grid.Row="1" Grid.Column="2" Foreground="#C4B5FD"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- System & Restore -->
            <TabItem Header="⚙ 系统与还原" Padding="14,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <CheckBox x:Name="ChkAutoStart" Content="开机自动启动 AuroraDesk" Foreground="#F1F5F9" FontSize="13" Margin="0,0,0,12" Click="SystemOption_Changed"/>
                    <CheckBox x:Name="ChkHideIcons" Content="隐藏桌面原有系统/文件夹图标（只保留毛玻璃工作台与壁纸）" Foreground="#F1F5F9" FontSize="13" Margin="0,0,0,12" Click="SystemOption_Changed"/>

                    <Border Background="#182032" BorderBrush="#2E3654" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="桌面文件与快速访问" FontSize="13" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkKeepDesktopFiles" Content="只分类，不移动桌面文件" Foreground="#F1F5F9" FontSize="13" Click="DesktopMode_Changed"/>
                            <TextBlock Text="原件仍在「桌面」，也会出现在收纳盒和搜索里。已经归档的文件留在 DesktopHub。"
                                       TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="11.5" Margin="0,6,0,10"/>
                            <CheckBox x:Name="ChkAutoTidy" Content="自动把桌面新文件移入 DesktopHub" Foreground="#F1F5F9" FontSize="12.5"
                                      Margin="0,0,0,12" Click="SystemOption_Changed"/>
                            <Button x:Name="BtnPinDesktopHub" Content="将 DesktopHub 固定到快速访问" HorizontalAlignment="Left"
                                    Padding="12,6" Click="PinDesktopHub_Click"/>
                            <TextBlock x:Name="QuickAccessStatus" Text="也可以在支持快速访问的「打开」或「另存为」窗口中使用。"
                                       Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#182032" BorderBrush="#2E3654" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="左侧收纳浮窗显示开关（即时生效）" FontSize="13" FontWeight="SemiBold" Foreground="#C4B5FD" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkShowRecent" Content="显示「最近使用」浮窗" Foreground="#F1F5F9" FontSize="12.5" Margin="0,0,28,0" Click="WidgetToggle_Changed"/>
                                <CheckBox x:Name="ChkShowMost" Content="显示「最多使用」浮窗" Foreground="#F1F5F9" FontSize="12.5" Click="WidgetToggle_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#28EF4444" BorderBrush="#66EF4444" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="无损还原原桌面" FontSize="13.5" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,0,0,6"/>
                            <TextBlock Text="点击下方按钮将把所有归档过的文件移回原始桌面位置、恢复系统桌面图标并关闭开机自启。"
                                       TextWrapping="Wrap" Foreground="#E2E8F0" FontSize="11.5" Margin="0,0,0,10"/>
                            <Button Content="一键还原原桌面并退出" HorizontalAlignment="Left" Padding="14,6" Click="BtnRestoreAll_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Save Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="关闭" Width="88" Height="32" Margin="0,0,10,0" Click="BtnClose_Click"/>
            <Button Content="保存并立即生效" Width="136" Height="32" Background="#7C3AED" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
