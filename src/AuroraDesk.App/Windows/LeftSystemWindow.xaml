<Window x:Class="AuroraDesk.App.Windows.LeftSystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220" Height="164" Title="系统图标"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
    <Border x:Name="RootBorder" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="13" CornerRadius="1.5" Background="#38BDF8" Margin="0,0,7,0"/>
                    <TextBlock Text="系统图标" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                </StackPanel>
                <TextBlock Text="拖动" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#88CBD5E1" FontSize="10" FontFamily="Microsoft YaHei UI"/>
            </Grid>

            <UniformGrid x:Name="IconsGrid" Grid.Row="1" Columns="3" Rows="2" Margin="0,6,0,0"/>
        </Grid>
    </Border>
</Window>
